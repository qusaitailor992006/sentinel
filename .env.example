# SENTINEL Environment Configuration Template
PROJECT_NAME="SENTINEL - Enterprise Trust & Safety Intelligence Platform"
ENVIRONMENT="development"
PORT=8000

# Database Configuration (Defaults to local SQLite WAL, can be replaced with PostgreSQL)
DATABASE_URL="sqlite:///./data/sentinel.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/sentinel_db"

# GroqCloud LLM Configuration (Obtain free key from https://console.groq.com)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_PRIMARY_MODEL="llama-3.3-70b-versatile"
GROQ_FALLBACK_MODEL="llama-3.1-8b-instant"

# Security & JWT Auth
SECRET_KEY="replace-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
